{
  "info": {
    "name": "AlSafi Project API",
    "description": "Collection of all APIs built for the AlSafi Project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_password\": \"new_secure_password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "change-password"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Currencies",
      "item": [
        {
          "name": "Get All Currencies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/currencies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies"
              ],
              "query": [
                {
                  "key": "visible",
                  "value": "true",
                  "disabled": true,
                  "description": "Optional: set to 'true' to get only visible currencies"
                }
              ]
            }
          }
        },
        {
          "name": "Create Currency",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"base_currency\": \"USD\",\n  \"target_currency\": \"TRY\",\n  \"buy_price\": 32.50,\n  \"sell_price\": 33.00,\n  \"sort_order\": 1,\n  \"is_visible\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/currencies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies"
              ]
            }
          }
        },
        {
          "name": "Get Currency by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/currencies/{{currency_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies",
                "{{currency_id}}"
              ]
            }
          }
        },
        {
          "name": "Update Currency",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buy_price\": 32.75,\n  \"sell_price\": 33.25\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/currencies/{{currency_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies",
                "{{currency_id}}"
              ]
            }
          }
        },
        {
          "name": "Delete Currency",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/currencies/{{currency_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies",
                "{{currency_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Prices",
      "item": [
        {
          "name": "Get Visible Prices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/prices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "prices"
              ]
            }
          }
        },
        {
          "name": "Update Price by ID",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buy_price\": 32.75,\n  \"sell_price\": 33.25\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/prices/{{currency_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "prices",
                "{{currency_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/settings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "settings"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your_admin_token_here",
      "type": "string"
    },
    {
      "key": "currency_id",
      "value": "1",
      "type": "string"
    }
  ]
}
