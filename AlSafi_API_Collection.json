{
  "info": {
    "name": "AlSafi Currency Display API",
    "description": "Postman collection for Al-Safi auth, currency CRUD, public prices, and settings APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Returns a Bearer token used by protected currency APIs."
          }
        },
        {
          "name": "Change Admin Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_password\": \"new_secure_password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "change-password"
              ]
            },
            "description": "Protected endpoint. Changes the password for the authenticated Supabase admin user."
          }
        }
      ]
    },
    {
      "name": "Currencies CRUD",
      "item": [
        {
          "name": "Get All Currencies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json.data) && json.data[0]?.id) {",
                  "  pm.collectionVariables.set('currency_id', json.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/currencies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies"
              ]
            },
            "description": "Public endpoint. Returns all currencies."
          }
        },
        {
          "name": "Get Visible Currencies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/currencies?visible=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies"
              ],
              "query": [
                {
                  "key": "visible",
                  "value": "true"
                }
              ]
            },
            "description": "Public endpoint. Returns currencies where is_visible is true."
          }
        },
        {
          "name": "Get Currency By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/currencies/{{currency_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies",
                "{{currency_id}}"
              ]
            },
            "description": "Public endpoint. Returns one currency by UUID."
          }
        },
        {
          "name": "Create Currency",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data?.id) {",
                  "  pm.collectionVariables.set('currency_id', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"base_currency\": \"USD\",\n  \"target_currency\": \"SYP\",\n  \"buy_price\": \"14500\",\n  \"sell_price\": \"14600\",\n  \"sort_order\": 10,\n  \"is_visible\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/currencies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies"
              ]
            },
            "description": "Protected endpoint. Requires Authorization: Bearer {{token}}."
          }
        },
        {
          "name": "Update Currency",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"base_currency\": \"USD\",\n  \"target_currency\": \"SYP\",\n  \"buy_price\": \"14550\",\n  \"sell_price\": \"14650\",\n  \"sort_order\": 10,\n  \"is_visible\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/currencies/{{currency_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies",
                "{{currency_id}}"
              ]
            },
            "description": "Protected endpoint. Any subset of fields can be sent."
          }
        },
        {
          "name": "Delete Currency",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/currencies/{{currency_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "currencies",
                "{{currency_id}}"
              ]
            },
            "description": "Protected endpoint. Deletes one currency by UUID."
          }
        }
      ]
    },
    {
      "name": "Public Display",
      "item": [
        {
          "name": "Get Visible Prices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/prices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "prices"
              ]
            },
            "description": "Public endpoint used by the headquarters display. Returns visible currencies only."
          }
        },
        {
          "name": "Legacy Update Price By ID",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buy_price\": \"14575\",\n  \"sell_price\": \"14675\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/prices/{{currency_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "prices",
                "{{currency_id}}"
              ]
            },
            "description": "Protected legacy endpoint. Prefer /api/currencies/:id for Flutter."
          }
        },
        {
          "name": "Get Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/settings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "settings"
              ]
            },
            "description": "Public endpoint. Returns ticker settings used by the display."
          }
        },
        {
          "name": "Update Settings Ticker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker_text\": \"AlSafi exchange rates update live.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/settings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "settings"
              ]
            },
            "description": "Protected endpoint. Updates the public ticker text."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "password123",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "currency_id",
      "value": "",
      "type": "string"
    }
  ]
}
